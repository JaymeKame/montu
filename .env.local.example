# Montu web app config. Copy to .env.local and fill in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Set to 1 to point auth + Firestore at the local emulators
NEXT_PUBLIC_FIREBASE_EMULATOR=

# --- server-only (Vercel env vars, never NEXT_PUBLIC_) ---
# Firebase Admin service account JSON (one line). Required for all /api writes.
FIREBASE_SERVICE_ACCOUNT=
# Key guarding /admin concierge view (?key=...)
ADMIN_SECRET=
# Twilio (SMS notification rail). Leave empty to run in stub mode (no sends).
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
